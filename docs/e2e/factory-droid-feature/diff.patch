--- a/app.js
+++ b/app.js
@@ -1 +1,5 @@
 export function slugify(value) { return value.trim().toLowerCase().replaceAll(' ', '-'); }
+
+export function reverseWords(value) {
+  return value.trim().split(/\s+/).reverse().join(' ');
+}
