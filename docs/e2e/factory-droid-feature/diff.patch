-import test from 'node:test'; import assert from 'node:assert/strict'; import { slugify } from './app.js'; test('slugify', () => assert.equal(slugify('Hello World'), 'hello-world'));
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { reverseWords, slugify } from './app.js';
+
+test('slugify', () => assert.equal(slugify('Hello World'), 'hello-world'));
+
+test('reverseWords returns an empty string for empty input', () => {
+  assert.equal(reverseWords(''), '');
+});
+
+test('reverseWords reverses words and normalizes multiple spaces', () => {
+  assert.equal(reverseWords('hello   world  again'), 'again world hello');
+});
